<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_tech_user" model="res.groups">
        <field name="name">TechFlow: Usuario IT</field>
    </record>

    <record id="group_tech_manager" model="res.groups">
        <field name="name">TechFlow: Gerente IT</field>
        <field name="implied_ids" eval="[(4, ref('group_tech_user'))]"/>
    </record>

    <record id="group_tech_rater" model="res.groups">
        <field name="name">TechFlow: Valorador</field>
    </record>

    <record id="tech_equipment_rater_rule" model="ir.rule">
        <field name="name">Valorador: Solo lectura de equipos</field>
        <field name="model_id" ref="model_tech_equipment"/>
        <field name="groups" eval="[(4, ref('group_tech_rater'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="tech_equipment_user_rule" model="ir.rule">
        <field name="name">Usuario IT: Puede ver todos los equipos</field>
        <field name="model_id" ref="model_tech_equipment"/>
        <field name="groups" eval="[(4, ref('group_tech_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="tech_equipment_manager_rule" model="ir.rule">
        <field name="name">Gerente IT: Control total</field>
        <field name="model_id" ref="model_tech_equipment"/>
        <field name="groups" eval="[(4, ref('group_tech_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="tech_category_manager_rule" model="ir.rule">
        <field name="name">Gerente IT: Gestión de categorías</field>
        <field name="model_id" ref="model_tech_category"/>
        <field name="groups" eval="[(4, ref('group_tech_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
