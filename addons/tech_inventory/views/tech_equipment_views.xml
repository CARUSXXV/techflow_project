<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tech_equipment_list" model="ir.ui.view">
        <field name="name">tech.equipment.list</field>
        <field name="model">tech.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipos Tecnológicos" 
                  decoration-danger="state == 'decommissioned'"
                  decoration-warning="state == 'repair'"
                  decoration-success="state == 'available'"
                  decoration-info="state == 'assigned'">
                <field name="name"/>
                <field name="state" widget="badge" 
                       decoration-danger="state == 'decommissioned'"
                       decoration-warning="state == 'repair'"
                       decoration-success="state == 'available'"
                       decoration-info="state == 'assigned'"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>

    <record id="view_tech_equipment_kanban" model="ir.ui.view">
        <field name="name">tech.equipment.kanban</field>
        <field name="model">tech.equipment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <span class="text-muted">Serial: </span>
                                    <field name="serial"/>
                                </div>
                                <div>
                                    <field name="category_id"/>
                                </div>
                                <div class="mt-2">
                                    <field name="state" widget="label_selection" options="{'classes': {'available': 'success', 'assigned': 'info', 'repair': 'warning', 'decommissioned': 'danger'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_tech_equipment_form" model="ir.ui.view">
        <field name="name">tech.equipment.form</field>
        <field name="model">tech.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipo">
                <header>
                    <button name="action_set_available" string="Disponible" type="object" class="btn-primary" invisible="state == 'available'"/>
                    <button name="action_set_repair" string="En reparación" type="object" invisible="state not in ['available', 'assigned']"/>
                    <button name="action_set_decommissioned" string="Desincorporado" type="object" invisible="state == 'decommissioned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,assigned,repair,decommissioned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_ratings" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-star">
                            <field name="rating_count" widget="statinfo" string="Valoraciones"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Desincorporado" bg_color="text-bg-danger" invisible="state != 'decommissioned'"/>
                    <widget name="web_ribbon" title="En Reparación" bg_color="text-bg-warning" invisible="state != 'repair'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del equipo..."/>
                        </h1>
                    </div>
                    
                    <notebook>
                        <page string="Datos Técnicos">
                            <group>
                                <group>
                                    <field name="category_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="serial"/>
                                    <field name="purchase_date"/>
                                </group>
                                <group>
                                    <field name="cost"/>
                                    <field name="tax_value" readonly="1"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                            <group>
                                <field name="notes" placeholder="Notas adicionales..." nolabel="1"/>
                            </group>
                        </page>
                        
                        <page string="Asignación">
                            <group>
                                <field name="employee_id" 
                                       placeholder="Empleado asignado..."
                                       readonly="state in ['repair', 'decommissioned']"
                                       force_save="1"/>
                                <field name="state" invisible="1"/>
                            </group>
                            <div class="alert alert-warning" role="alert" invisible="state != 'repair'">
                                ⚠️ Este equipo está en reparación, no puede ser asignado temporalmente.
                            </div>
                        </page>
                        <page string="Valoraciones">
                            <div class="mb-2">
                                <button name="action_add_rating" 
                                        string="Nueva Valoración" 
                                        type="object" 
                                        class="btn-primary" 
                                        icon="fa-star"/>
                            </div>
                            <field name="rating_ids" readonly="1">
                                <list>
                                    <field name="rating_date"/>
                                    <field name="evaluated_by_id"/>
                                    <field name="rating" widget="priority"/>
                                    <field name="is_recommended" widget="boolean_toggle" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tech_equipment_search" model="ir.ui.view">
        <field name="name">tech.equipment.search</field>
        <field name="model">tech.equipment</field>
        <field name="arch" type="xml">
            <search string="Buscar Equipos">
                <field name="name"/>
                <field name="serial"/>
                <field name="category_id"/>
                <field name="employee_id"/>
                <filter name="available" string="Disponibles" domain="[('state', '=', 'available')]"/>
                <filter name="assigned" string="Asignados" domain="[('state', '=', 'assigned')]"/>
                <filter name="repair" string="En reparación" domain="[('state', '=', 'repair')]"/>
                <filter name="decommissioned" string="Desincorporados" domain="[('state', '=', 'decommissioned')]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_category" string="Categoría" context="{'group_by': 'category_id'}"/>
                    <filter name="group_by_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tech_equipment" model="ir.actions.act_window">
        <field name="name">Equipos</field>
        <field name="res_model">tech.equipment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_tech_equipment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Registra tus primeros equipos tecnológicos!
            </p>
        </field>
    </record>
</odoo>
